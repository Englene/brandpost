# Kopier til .env og fyll ut. .env er git-ignorert.

# ── Tekstmodell (påkrevd) ──────────────────────────────────
# Standard bakende er Anthropic-API-et.
ANTHROPIC_API_KEY=
# Alternativ: bruk Claude Code-kommandolinja i stedet (gratis for abonnenter).
# BRANDPOST_MODEL_BACKEND=cli
# BRANDPOST_MODEL=claude-sonnet-5
# Fallbacken MÅ være en annen modellfamilie enn primæren: er begge like, har en
# overbelastning ingen fluktvei.
# BRANDPOST_MODEL_FALLBACK=claude-haiku-4-5-20251001

# ── Bildemotor (velg minst én) ─────────────────────────────
# Uten nøkkel faller kortene tilbake til rene typografi-kort. De er fine, men
# du mister motivene.
GEMINI_API_KEY=
OPENAI_API_KEY=
# BRANDPOST_IMAGE_BACKEND=gemini      # eller: openai

# ── LinkedIn (kun for publisering) ─────────────────────────
# Alt under er valgfritt. Uten det genererer systemet som normalt, du får bare
# ikke publisert fra det.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
# Sikkerhetsbryteren. Alt annet enn 1 betyr tørrkjøring: ingenting publiseres.
LINKEDIN_ENABLED=0

# ── Arbeidsmappe ───────────────────────────────────────────
# Hvor utkast, plan og notater havner. Standard: ./workspace
# BRANDPOST_WORKSPACE=

# ── E-post (valgfritt) ─────────────────────────────────────
# Uten dette tørrkjører all e-post. Dashbordet er hovedflaten uansett.
# BRANDPOST_MAIL_ENABLED=1
# BRANDPOST_SMTP_USER=
# BRANDPOST_SMTP_PASSWORD=
# BRANDPOST_MAIL_TO=
