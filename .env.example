# Kopier til .env og fyll ut. .env er git-ignorert.

# ── Tekstmodell (påkrevd) ──────────────────────────────────
# Standard bakende er Anthropic-API-et.
ANTHROPIC_API_KEY=
# Alternativ: bruk Claude Code-kommandolinja i stedet (gratis for abonnenter).
# BRANDPOST_MODEL_BACKEND=cli
# BRANDPOST_MODEL=claude-sonnet-5
# Fallbacken MÅ være en annen modellfamilie enn primæren: er begge like, har en
# overbelastning ingen fluktvei.
# BRANDPOST_MODEL_FALLBACK=claude-haiku-4-5-20251001

# ── Bildemotor (velg minst én) ─────────────────────────────
# Uten nøkkel faller kortene tilbake til rene typografi-kort. De er fine, men
# du mister motivene.
GEMINI_API_KEY=
OPENAI_API_KEY=
# BRANDPOST_IMAGE_BACKEND=gemini      # eller: openai

# ── LinkedIn (kun for publisering) ─────────────────────────
# Alt under er valgfritt. Uten det genererer systemet som normalt, du får bare
# ikke publisert fra det.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
# Sikkerhetsbryteren. Alt annet enn 1 betyr tørrkjøring: ingenting publiseres.
LINKEDIN_ENABLED=0

# ── Arbeidsmappe ───────────────────────────────────────────
# Hvor utkast, plan og notater havner. Standard: ./workspace
# BRANDPOST_WORKSPACE=

# ── E-post (valgfritt) ─────────────────────────────────────
# Uten dette tørrkjører all e-post. Dashbordet er hovedflaten uansett.
# BRANDPOST_MAIL_ENABLED=1
# BRANDPOST_SMTP_USER=
# BRANDPOST_SMTP_PASSWORD=
# BRANDPOST_MAIL_TO=

# ── Publiseringsrytme ──────────────────────────────────────
# BRANDPOST_POST_DAYS=0,1,2,3      # ukedager (0=mandag). Standard man-tor
# BRANDPOST_POST_TIME=10:00        # foreslått klokkeslett (hele kvarter)
# BRANDPOST_CATCHUP_H=6            # hvor sent et forfalt innlegg fortsatt kan gå ut
# BRANDPOST_BRANDS=mitt-firma      # kjør kun disse merkene (komma). Standard: alle enabled
# Hvor merker letes etter, i tillegg til de innebygde. Kolon-separert som PATH,
# og dine egne vinner ved navnekollisjon. Bruk den når merkevaren din, altså
# strategien, stemmen og logoene, skal bo et privat sted mens motoren
# installeres herfra.
# BRANDPOST_BRANDS_DIR=~/mine-merker

# ── Bildekvalitet ──────────────────────────────────────────
# 2K gir 1856x2304, altså NEDSKALERING mot lerretet på 1080x1350. Skrur du den til
# 1K, blir motivet oppskalert og synlig uskarpt ved siden av typografien.
# BRANDPOST_IMAGE_RES=2K
# BRANDPOST_IMAGE_QUALITY=high     # kun gpt-image-2
# BRANDPOST_IMAGE_MODEL=           # overstyr Gemini-modellen
# BRANDPOST_OPENAI_MODEL=          # overstyr OpenAI-modellen

# ── Nettleser-publisering (les ToS-avsnittet i README først) ──
# BRANDPOST_BROWSER_ENABLED=1
# BRANDPOST_LINKEDIN_PAGE_URL=https://www.linkedin.com/company/<ID>/admin/
# BRANDPOST_BROWSER_PROFILE=       # hvor den innloggede nettleserprofilen lagres

# ── Avansert ───────────────────────────────────────────────
# BRANDPOST_MAX_TOKENS=8000
# BRANDPOST_CLAUDE_BIN=            # sti til claude, hvis den ikke er på PATH
# BRANDPOST_SMTP_HOST=smtp.gmail.com
# BRANDPOST_SMTP_PORT=587
# BRANDPOST_VISION_MODEL=          # billig modell som leser tilbake tekst i bilder
